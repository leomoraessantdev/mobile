APP_NAME="Agendamento de Consultas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite: o arquivo database/database.sqlite e criado automaticamente
# pelo "php artisan migrate" quando ainda nao existe.
DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/absoluto/para/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Origens liberadas no CORS (separadas por virgula). Use "*" apenas em
# desenvolvimento, quando o app roda no Expo Go de um dispositivo fisico.
CORS_ALLOWED_ORIGINS=*
